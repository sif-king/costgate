# costgate manager 镜像（docker-compose.yml 的 manager 服务）
#
# 用途有两种，本文件同时满足：
#   ① 分离部署（docker-compose.yml 现状）：manager 只挂 docker.sock，代理跑独立容器，
#      容器内 isProcessRunning / stopProxy 走 `docker container inspect|stop`
#      （见 lib/process-manager.js 的 IS_DOCKER 分支），不依赖本地进程。
#   ② 单容器托管：镜像里带代理源码与依赖，startProxy 走 spawn 时能真跑起来。
#
# 🔴 代理依赖为什么必须从 builder 拿：
#   cursor-proxy/dist 不入库，且被 .dockerignore 的 `dist` 排除 —— 直接 COPY 宿主机的 dist
#   在干净 clone 上必然失败（2026-11-09 登记的已知债）。改成从源码构建后，dist 不再来自宿主机。
#   同时把 node_modules 一起带进来：否则容器里代理注册成功却一启动就 Cannot find module，
#   而「管理-only 镜像 + 注册了却起不来」是最坏结果（2026-11-09 老板拍：容器托管代理运行时）。
#   代码侧同样如此：buildProxyConfigs 用 fs.existsSync 探测入口，只 COPY 源码不装依赖
#   会让入口「存在但跑不了」，比不注册更难查。
#
# ⚠️ hermes-proxy 是 Python（Flask + pyyaml + requests），本镜像不含 Python 运行时，
#    因此只 COPY 源码、不装依赖：它按 docker-compose.yml 跑独立容器。
#    单容器形态下 manager 面板会列出 hermes 但 spawn 会失败 —— 这一条在
#    scripts/docker-context-allow.txt 里登记着，未修前别对外说「单容器托管全部代理」。
#    修法（若要做）：加 python:3.11-slim builder 装依赖后 COPY site-packages 进来，
#    但 node 镜像与 python 镜像的 site-packages 路径/版本必须对齐，需在有 docker 的机器上验。

# ---- codex-proxy：纯 JS 依赖（dotenv / express）----
FROM node:20-alpine AS codex-builder

WORKDIR /build

COPY codex-proxy/package.json codex-proxy/package-lock.json* ./
RUN npm ci --omit=dev

# ---- cursor-proxy：TS 需 tsc 出 dist；better-sqlite3 是 native，musl 下要从源码编译 ----
FROM node:20-alpine AS cursor-builder

WORKDIR /build

RUN apk add --no-cache python3 make g++

COPY cursor-proxy/package.json cursor-proxy/package-lock.json* ./
RUN npm ci

COPY cursor-proxy/ ./
RUN npm run build

FROM node:20-alpine

RUN apk add --no-cache lsof docker-cli

WORKDIR /app

# Manager 自身
COPY multi-proxy-manager/package.json multi-proxy-manager/package-lock.json* ./multi-proxy-manager/
RUN cd multi-proxy-manager && npm install --production

COPY multi-proxy-manager/ ./multi-proxy-manager/

# P0-1 补充：buildProxyConfigs 用 path.join(__dirname,'..') 找各代理目录，
# 容器内必须是 /app/{codex-proxy,hermes-proxy,cursor-proxy}
# 与宿主机仓库布局一致，否则 "Managed proxies: none"。
COPY codex-proxy/ ./codex-proxy/
COPY --from=codex-builder /build/node_modules ./codex-proxy/node_modules

COPY hermes-proxy/ ./hermes-proxy/

# 🔴 l2/ 与 packs/ 是 manager 的运行时常驻依赖，不是可选件：
#   server.js 第 14 行 require('../l2/fs-observer.js')，lib/forward.js require ../../packs/sandbox-egress。
#   2026-11-16 实测：漏了这两条，镜像能构建成功但容器起来立刻 MODULE_NOT_FOUND 退出——
#   「构建绿」不等于「跑得起来」，所以下面必须有真起容器的冒烟（scripts/verify-docker-image.sh）。
#   两者只依赖 express（已在 manager 的 node_modules 里），不需要额外装包。
COPY l2/ ./l2/
COPY packs/ ./packs/

COPY cursor-proxy/package.json ./cursor-proxy/
COPY --from=cursor-builder /build/dist ./cursor-proxy/dist
COPY --from=cursor-builder /build/node_modules ./cursor-proxy/node_modules

ENV PORT=18792

EXPOSE 18792

CMD ["node", "multi-proxy-manager/server.js"]
