FROM node:20-alpine

RUN apk add --no-cache lsof docker-cli

WORKDIR /app

# Manager 自身
COPY multi-proxy-manager/package.json multi-proxy-manager/package-lock.json* ./manager/
RUN cd manager && npm install --production

COPY multi-proxy-manager/ ./manager/

# P0-1 补充：buildProxyConfigs 用 path.join(__dirname,'..') 找各代理目录，
# 容器内必须是 /deploy/{codex-proxy,hermes-proxy,cursor-proxy}
# 与宿主机仓库布局一致，否则 "Managed proxies: none"。
#
# ⚠️ 2026-11-09 核查：下面 `COPY cursor-proxy/dist` 在当前 .dockerignore 下必然失败 ——
#   .dockerignore 排除了 dist 和 node_modules，而 dist 也不入库（git ls-files 查不到）。
#   本机能构建只是因为本机 cursor-proxy/dist 恰好存在。详见 PROJECT-STATE/PUBLISH-READINESS-2026-11-09.md。
COPY codex-proxy/ ./codex-proxy/
COPY hermes-proxy/ ./hermes-proxy/
COPY cursor-proxy/package.json ./cursor-proxy/
COPY cursor-proxy/dist ./cursor-proxy/dist

ENV PORT=18792

EXPOSE 18792

CMD ["node", "manager/server.js"]
