# DSH Proxy 环境变量配置
# 使用方法：复制此文件为 .env 并填入实际值
#   cp .env.example .env
#
# 这份文件的意义不只是模板：install.sh 只在「有 .env.example」时才建 .env，
# 所以缺了它，PORT 就会落到 proxy.js 里的默认值上。dsh-proxy 的默认值曾经是
# 18790（= codex 的端口，拷贝遗留），结果是全新用户装完 dsh 起不来、且报错
# 只说「启动失败」。2026-11-08 补上本文件，并把默认值改成 18797。
#
# 代理端口 (默认: 18797 — 与 manage.sh 的 DSH_PORT 一致)
PORT=18797

# 绑定地址。默认只绑本机；暴露到网络前必须同时设 PROXY_AUTH_TOKEN。
# BIND_HOST=0.0.0.0
# PROXY_AUTH_TOKEN=

# ============================================
# 上游模型 API Key — 按需配置，不用的留空即可
# ============================================
# DSH 本身是 DeepSeek 官方 harness 的配套代理，配 DeepSeek key 最直接；
# 也可以完全留空，改在 ~/.multi-proxy-manager/providers.json 里配上游
# （面板「上游」页写的就是这个文件，顶层必须是数组）。

# DeepSeek API Key
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot/Kimi API Key
# 申请地址: https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Agnes AI API Key
# 申请地址: https://agnes-ai.com
AGNES_API_KEY=

# ============================================
# 门控（默认全关 = 按原样转发，不干预）
# ============================================
# 预算守门
# PROXY_BUDGET_GUARD=1
# 模型列表自动同步
# PROXY_MODEL_SYNC=1
# 熔断
# PROXY_CIRCUIT_BREAKER=1
# PROXY_CIRCUIT_MODE=
